#!/usr/bin/env bash
# 提交信息：Conventional Commits；不是 agent 回复原文；不含私网 IP、内网 / tailnet 主机名、个人路径、私有模式与密钥。
set -euo pipefail
lib=$(cd "$(dirname "$0")/../lib" && pwd)
. "$lib/aep.sh"
. "$lib/security.sh"
sec_env
msg=$(sec_clean_message < "$1")
subject=$(awk 'NF { print; exit }' <<< "$msg")
fail=0
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*|amend!*) ;;
  *)
    if ! grep -Eq '^(feat|fix|docs|test|refactor|perf|ci|chore|build|style|revert)(\([^)]+\))?!?: .+' <<< "$subject"; then
      echo "✗ 提交标题需符合 type(scope): 描述 —— 当前：$subject" >&2
      fail=1
    fi ;;
esac
sec_scan --input message <<< "$msg" >&2 || fail=1
if sec_has_gitleaks && ! gitleaks stdin --no-banner --redact -l error <<< "$msg" >/dev/null 2>&1; then
  echo "✗ gitleaks：提交信息里有疑似密钥" >&2
  fail=1
fi
if [ "$fail" != 0 ]; then
  echo "提交信息已保存在 $1：改写为用户视角的一句话，去掉主机名 / IP / 路径 / 密钥后重新提交。" >&2
  exit 1
fi
